# copy to .env and fill in, channel name and music services are set up in /admin instead

PORT=8787

# public url of this server, no trailing slash, spotify redirects to $BASE_URL/auth/callback and only accepts plain http for 127.0.0.1 not localhost, use your domain over https in production, e.g. https://ktv.example.com
BASE_URL=http://127.0.0.1:8787

# optional shared secret, when set open the tv once as /tv?key=<ACCESS_KEY> and a cookie remembers the device afterwards
ACCESS_KEY=

# how long the lineup snapshot is reused before it's read again
LIBRARY_TTL_HOURS=12

# 0 means no limit, otherwise cuts each clip after this many seconds
MAX_CLIP_SECONDS=0

# seconds cut from the end of every video before the transition to the next one
END_CUT_SECONDS=10

# where settings, tokens and caches are kept (default: ./data)
# DATA_DIR=
